{
  "name": "agent-404",
  "version": "0.1.0",
  "description": "Make 404 pages agent-friendly for AI crawlers & LLMs",
  "keywords": [
    "404",
    "seo",
    "ai-agents",
    "claudebot",
    "gptbot",
    "perplexitybot",
    "json-ld",
    "link-headers"
  ],
  "author": "Bharath",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bharath31/agent-404"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "agent-404": "./bin/agent-404.js"
  },
  "exports": {
    "./client": "./public/agent-404.min.js"
  },
  "files": [
    "bin",
    "public/agent-404.min.js",
    "SPEC.md",
    "README.md"
  ],
  "scripts": {
    "dev": "vercel dev",
    "dev:cf": "wrangler dev",
    "deploy": "vercel --prod",
    "deploy:cf": "wrangler deploy",
    "build:script": "tsx script/build.ts",
    "build:types": "tsc -p tsconfig.adapters.json",
    "build:packages": "tsx script/build-packages.ts all",
    "prepublishOnly": "npm run build:script && npm run build:types",
    "db:migrate": "tsx migrations/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:browser": "npx playwright test"
  },
  "dependencies": {
    "@auth0/auth0-hono": "^1.2.6",
    "@auth0/auth0-server-js": "^1.12.1",
    "@hono/node-server": "^2.1.1",
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/analytics": "^2.0.1",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260313.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.2.0",
    "@vercel/node": "^5.6.15",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.73.0"
  }
}
