{
  "name": "agent-404",
  "version": "0.1.0",
  "description": "Make 404 pages agent-friendly for AI crawlers & LLMs",
  "keywords": [
    "404",
    "seo",
    "ai-agents",
    "claudebot",
    "gptbot",
    "perplexitybot",
    "json-ld",
    "link-headers"
  ],
  "author": "Bharath",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bharath31/agent-404"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "agent-404": "./bin/agent-404.js"
  },
  "exports": {
    "./client": "./public/agent-404.min.js"
  },
  "files": [
    "bin",
    "public/agent-404.min.js",
    "SPEC.md",
    "README.md"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy": "vercel --prod",
    "build:script": "tsx script/build.ts",
    "build:types": "tsc -p tsconfig.adapters.json",
    "build:packages": "tsx script/build-packages.ts all",
    "verify": "npm test && npm run build && npm run build:types && npm run build:packages && npm run build:script",
    "prepublishOnly": "npm run build:script && npm run build:types",
    "db:migrate": "tsx migrations/run.ts",
    "labels:sample": "tsx scripts/label-suggestions.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:browser": "npx playwright test"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/analytics": "^2.0.1",
    "geist": "^1.7.2",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@auth0/auth0-server-js": "^1.12.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.24.0",
    "hono": "^4.13.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
